// The Roles Anywhere credential helper requires go-tpm v0.3.3, which requires go-tpm-tools v0.2.0 and
// through it a google.golang.org/genproto from before the split. That monolith holds the packages that
// google.golang.org/genproto/googleapis/{api,rpc} now hold, so a workspace that selects it fails to build
// with an ambiguous import. These two versions are the ones the graph falls back to.
exclude (
	google.golang.org/genproto v0.0.0-20180817151627-c66870c02cf8
	google.golang.org/genproto v0.0.0-20200526211855-cb27e3aa2013
)
